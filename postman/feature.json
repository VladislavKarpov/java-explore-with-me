  "item": [
    {
      "name": "Setup",
      "item": [
        {
          "name": "Create User 1",
          "event": [{"listen": "test", "script": {"exec": [
            "pm.test('Status is 201', () => pm.response.to.have.status(201));",
            "pm.collectionVariables.set('userId1', pm.response.json().id);"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "url": "{{baseUrl}}/admin/users",
            "body": {"mode": "raw", "raw": "{\"email\": \"user1feature@email.com\", \"name\": \"User One\"}"}
          }
        },
        {
          "name": "Create User 2",
          "event": [{"listen": "test", "script": {"exec": [
            "pm.test('Status is 201', () => pm.response.to.have.status(201));",
            "pm.collectionVariables.set('userId2', pm.response.json().id);"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "url": "{{baseUrl}}/admin/users",
            "body": {"mode": "raw", "raw": "{\"email\": \"user2feature@email.com\", \"name\": \"User Two\"}"}
          }
        },
        {
          "name": "Create Category",
          "event": [{"listen": "test", "script": {"exec": [
            "pm.test('Status is 201', () => pm.response.to.have.status(201));",
            "pm.collectionVariables.set('categoryId', pm.response.json().id);"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "url": "{{baseUrl}}/admin/categories",
            "body": {"mode": "raw", "raw": "{\"name\": \"FeatureCategory\"}"}
          }
        },
        {
          "name": "Create Event",
          "event": [{"listen": "test", "script": {"exec": [
            "pm.test('Status is 201', () => pm.response.to.have.status(201));",
            "pm.collectionVariables.set('eventId', pm.response.json().id);"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "url": "{{baseUrl}}/users/{{userId1}}/events",
            "body": {"mode": "raw", "raw": "{\"annotation\": \"Test event annotation for feature tests\", \"category\": {{categoryId}}, \"description\": \"Test event description for feature tests minimum length\", \"eventDate\": \"2030-01-01 12:00:00\", \"location\": {\"lat\": 55.75, \"lon\": 37.61}, \"paid\": false, \"participantLimit\": 10, \"requestModeration\": false, \"title\": \"Test Event Feature\"}"}
          }
        },
        {
          "name": "Publish Event",
          "event": [{"listen": "test", "script": {"exec": [
            "pm.test('Status is 200', () => pm.response.to.have.status(200));",
            "pm.test('Event is published', () => pm.expect(pm.response.json().state).to.equal('PUBLISHED'));"
          ]}}],
          "request": {
            "method": "PATCH",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "url": "{{baseUrl}}/admin/events/{{eventId}}",
            "body": {"mode": "raw", "raw": "{\"stateAction\": \"PUBLISH_EVENT\"}"}
          }
        }
      ]
    },
