  },
  "variable": [
    {"key": "baseUrl", "value": "http://localhost:8080"},
    {"key": "userId1", "value": "1"},
    {"key": "userId2", "value": "2"},
    {"key": "eventId", "value": "1"},
    {"key": "commentId", "value": "1"},
    {"key": "locationId", "value": "1"},
    {"key": "noteId", "value": "1"},
