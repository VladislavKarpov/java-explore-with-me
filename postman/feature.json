        },
        {
          "name": "Delete Comment by Admin",
          "event": [{"listen": "test", "script": {"exec": [
            "pm.test('Status is 204', () => pm.response.to.have.status(204));"
          ]}}],
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/admin/comments/{{commentId}}"
